# HTTP port exposed by the dashboard service.
PORT=3000

# Persistent SQLite database path for tracked open events.
DATABASE_PATH=/data/tracker.sqlite

# Docker Mailserver configuration mount used for Rspamd overrides and logs.
DMS_ROOT=/dms

# Rspamd directory where the dashboard writes rspamd.local.lua. Defaults to ${DMS_ROOT}/rspamd.
RSPAMD_DIR=/dms/config/rspamd

# Trust proxy setting for Express. Leave false unless you run behind your own proxy.
TRUST_PROXY=false

# Public base URL used in tracking pixel links. Leave blank to disable filter install and show a dashboard warning.
TRACKING_BASE_URL=

# Comma-separated log aliases and mounted file paths shown in the dashboard.
LOG_FILES=rspamd:/dms/logs/rspamd.log,mail:/dms/logs/mail.log
